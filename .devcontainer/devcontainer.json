{
  "name": "hello-kubernetes",
  "build": { "dockerfile": "Dockerfile", "context": ".." },

  // Container settings
  "remoteUser": "vscode",
  "shutdownAction": "stopContainer",
  "init": true,

  // Features
  "features": {
    // Install Docker CE, not the OSS Moby build. v4 also mounts volumes on
    // /var/lib/docker and /var/lib/containerd, which an overlay root needs.
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false }
  },

  // Port forwarding
  "forwardPorts": [8080, 4321, 18080, 18081, 18082],
  "portsAttributes": {
    "8080": { "label": "hello-kubernetes", "onAutoForward": "notify" },
    "4321": { "label": "website (make site-dev)", "onAutoForward": "notify" },
    "18080": { "label": "kind Ingress (make cluster-kind)", "onAutoForward": "silent" },
    "18081": { "label": "kind Gateway (make cluster-kind)", "onAutoForward": "silent" },
    "18082": { "label": "k3d Ingress and Gateway (make cluster-k3d)", "onAutoForward": "silent" }
  }
}
