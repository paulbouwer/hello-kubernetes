---
// Starlight's social links in the header, with Docs and Config builder links
// before them on the landing page only. The docs pages have the sidebar.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL;
const isLanding = Astro.url.pathname === base;
---

{
  isLanding && (
    <nav class="hk-header-links" aria-label="Site">
      <a href={`${base}docs/start-here/overview/`}>Docs</a>
      <a href={`${base}docs/configure/builder/`}>Config builder</a>
    </nav>
  )
}
<Default />

<style>
  .hk-header-links {
    display: flex;
    gap: 1.25rem;
    margin-inline-end: 0.5rem;
  }
  .hk-header-links a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .hk-header-links a:hover {
    color: var(--sl-color-white);
  }
</style>
