---
// Starlight's footer (previous and next links), with links to report an issue
// and to contribute. Contributing has its own docs in the repo, not the site.
import Default from '@astrojs/starlight/components/Footer.astro';

const repo = 'https://github.com/paulbouwer/hello-kubernetes';
---

<Default><slot /></Default>
<p class="hk-footer">
  <a href={`${repo}/issues/new/choose`}>Report an issue</a>
  <span aria-hidden="true">·</span>
  <a href={`${repo}/blob/main/CONTRIBUTING.md`}>Contribute</a>
  <span aria-hidden="true">·</span>
  <a href={`${import.meta.env.BASE_URL}licences/fonts/`}>Font licences</a>
</p>

<style>
  .hk-footer {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
  }
  .hk-footer a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .hk-footer a:hover {
    color: var(--sl-color-accent-high);
  }
</style>
