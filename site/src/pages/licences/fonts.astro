---
// The licences of the fonts the site and the live preview use. The licence
// files are copied from the font packages by scripts/copy-font-licences.mjs.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = `${import.meta.env.BASE_URL}licences/fonts/`;
const fonts = [
  { name: 'Archivo', file: 'archivo.txt', licence: 'SIL Open Font Licence 1.1' },
  { name: 'Inter', file: 'inter.txt', licence: 'SIL Open Font Licence 1.1' },
  { name: 'JetBrains Mono', file: 'jetbrains-mono.txt', licence: 'SIL Open Font Licence 1.1' },
  { name: 'Ubuntu', file: 'ubuntu.txt', licence: 'Ubuntu Font Licence 1.0' },
];
---

<StarlightPage frontmatter={{ title: 'Font licences', description: 'The fonts this site uses, and their licences.' }}>
  <p>This site uses these fonts, served from the site itself. Each ships with its licence.</p>
  <ul>
    {fonts.map((f) => <li><a href={`${base}${f.file}`}>{f.name}</a>: {f.licence}</li>)}
  </ul>
</StarlightPage>
